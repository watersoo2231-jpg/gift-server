# =============================================
# 선물하기 서버 환경변수 설정
# 이 파일을 복사하여 .env 파일로 저장 후 값을 채워주세요
# cp .env.example .env
# =============================================

# 카페24 쇼핑몰 정보
CAFE24_MALL_ID=pathocrionwater
CAFE24_CLIENT_ID=여기에_카페24_앱_클라이언트_ID
CAFE24_CLIENT_SECRET=여기에_카페24_앱_클라이언트_SECRET
CAFE24_WEBHOOK_SECRET=여기에_웹훅_시크릿키

# 쿨SMS (알림톡 발송) - https://coolsms.co.kr 에서 발급
COOLSMS_API_KEY=여기에_쿨SMS_API_KEY
COOLSMS_API_SECRET=여기에_쿨SMS_API_SECRET
COOLSMS_SENDER=01000000000

# 카카오 채널 정보
KAKAO_CHANNEL_ID=@채널아이디
KAKAO_TEMPLATE_ID=알림톡템플릿코드

# 배송지 입력 페이지 URL
GIFT_ADDRESS_URL=https://pathocrionwater.cafe24.com/web/upload/gift_address.html

# 선물 만료일 (일 수, 기본 7일)
GIFT_EXPIRE_DAYS=7

# 서버 설정
PORT=5000
DEBUG=false
